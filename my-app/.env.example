# Conexão com TiDB Cloud Starter (MySQL 8.5 compatível)
# Para CLI Prisma (schema engine): incluir sslaccept=strict
DATABASE_URL="mysql://usuario:senha@gateway01.sa-east-1.prod.aws.tidbcloud.com:4000/marcon_almoxarifado?sslaccept=strict"

# Variáveis opcionais para seed de administrador
# ADMIN_LOGIN="admin"
# ADMIN_PASSWORD="senha-forte-do-admin"
# ADMIN_NAME="Administrador do Sistema"

# Variável opcional para senha padrão de seed dos funcionários fictícios
# SEED_DEFAULT_PASSWORD="senha-forte-para-testes"

# Autenticação facial: a chave fica fora do repositório
FACE_SERVICE_URL=https://face-service.internal.example
FACE_SERVICE_TOKEN=replace-with-secret-manager-value
FACE_EMBEDDING_ENCRYPTION_KEY=replace-with-64-hex-characters
FACE_MATCH_THRESHOLD=0.42
TRUSTED_DEVICE_LIMIT=7
# Login facial obrigatório somente para ADMIN; false é apenas para teste e é ignorado em produção.
LOGIN_FACIAL_OBRIGATORIO=true
# Chave aleatória com pelo menos 32 caracteres para assinar estados intermediários do login.
LOGIN_CHALLENGE_SECRET=
